# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Mobile App & Core API Configuration
PORT=3000
VITE_API_BASE_URL=""
# MOMO_WEBHOOK_SECRET: Shared secret that telecom callbacks must send in the
# X-Webhook-Secret header to POST /api/momo/webhook. If unset, the webhook
# rejects every request (503). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MOMO_WEBHOOK_SECRET=""
ORANGE_MONEY_API_KEY="fnd_sandbox_orange_money_2025"
BULK_SMS_GATEWAY_URL="https://api.camtel.cm/sms/v1/dispatch"
BULK_SMS_SENDER_ID="FindNdap"
