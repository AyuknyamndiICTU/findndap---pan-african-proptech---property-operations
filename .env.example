# FindNdap configuration. Run "npm run setup" to create .env from this file with
# freshly generated secrets, or copy it to .env and fill the values in yourself.
# On Vercel, set the same variables in Project Settings -> Environment Variables
# (.env is only used on your own computer and is never committed).

# ------------------------------------------------------------------------------
# Server (local only; Vercel ignores PORT)
# ------------------------------------------------------------------------------
PORT=3000

# ------------------------------------------------------------------------------
# Database: Neon Postgres
# Paste the *pooled* connection string from the Neon console (Connect -> "Connection pooling" on;
# the host contains "-pooler"). For local development use a separate Neon branch (e.g. "dev")
# so you never touch production data. On Vercel the Neon integration sets DATABASE_URL for you.
# Tables are created on first start and filled with demo data (set SEED_DEMO_DATA=false to skip).
# ------------------------------------------------------------------------------
DATABASE_URL=""
# SEED_DEMO_DATA="true"
# Maximum connections per server instance (default 5).
# DATABASE_POOL_MAX="5"

# ------------------------------------------------------------------------------
# Accounts (synchronised into the database at every start; .env is the source of truth)
# Reading data is public; every change requires one of these logins.
# Passwords must be at least 8 characters. Removing an account here disables it.
# ------------------------------------------------------------------------------
# Landlord / administrator: console changes, payments, SMS, work-orders, agent approvals.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
# Agent accounts, comma-separated "username:password" pairs (passwords may not contain commas).
# Agents apply for certification; once an administrator approves them they can register buildings.
AGENT_ACCOUNTS=""

# ------------------------------------------------------------------------------
# Mobile Money
# ------------------------------------------------------------------------------
# Shared secret that telecom callbacks must send in the X-Webhook-Secret header to
# POST /api/momo/webhook. If unset, the webhook rejects every request (503).
MOMO_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# Android app download (read at BUILD time by Vite - on Vercel, redeploy after changing)
# Leave empty until a real APK is published; the download buttons then say
# "APK not available yet". Use an https:// URL or a file path under public/ (e.g. /downloads/findndap.apk).
# ------------------------------------------------------------------------------
VITE_APK_URL=""
VITE_APK_VERSION=""
VITE_APK_RC_URL=""
VITE_APK_RC_VERSION=""

# ------------------------------------------------------------------------------
# Reserved for future integrations - NOT used by the code yet.
# SMS broadcasts are stored and counted but not sent to a real SMS provider,
# and Orange Money payments arrive only through the webhook/console.
# ------------------------------------------------------------------------------
# ORANGE_MONEY_API_KEY=""
# BULK_SMS_GATEWAY_URL=""
# BULK_SMS_SENDER_ID="FindNdap"
